@page
@model organaizer.Pages.CompanySelection.SelectModel
@{ Layout = null; ViewData["Title"] = "Выбор компании"; }
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Выбор компании · Finance Flow</title><link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true"/><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@@1.4.0/dist/css/tabler.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body class="login-body"><main class="container-tight py-6"><div class="text-center mb-5"><span class="brand-mark d-inline-flex mb-3">F</span><h1>Выберите компанию</h1><p class="text-secondary">Данные и балансы каждой компании разделены</p></div><div class="row g-3">@foreach(var company in Model.Companies){<div class="col-12"><form method="post"><input type="hidden" name="companyId" value="@company.Id"/><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"/><button class="card card-body w-100 text-start company-select-card"><div class="d-flex align-items-center"><span class="avatar avatar-lg bg-indigo-lt me-3">@(company.Kind == organaizer.Domain.CompanyKind.Broker ? "OC" : "A&A")</span><div><h2 class="mb-1">@company.Name</h2><div class="text-secondary">@(company.Kind == organaizer.Domain.CompanyKind.Broker ? "Криптообменные операции" : "Ликвидность, банки и балансы")</div></div><span class="ms-auto fs-1">→</span></div></button></form></div>}</div></main></body></html>
