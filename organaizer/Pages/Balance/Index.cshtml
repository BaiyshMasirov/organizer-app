@page
@model organaizer.Pages.Balance.IndexModel
@{ ViewData["Title"] = "Баланс"; }

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div><h1 class="mb-1">Баланс · @Model.ActiveCompany.Name</h1><div class="text-secondary">Деньги на кошельках, биржах и в банках</div></div>
  <div class="text-secondary">@Model.Items.Count источников</div>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="btn-list mb-4"><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#transfer-modal">⇄ Перевод</button><button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#convert-modal">¤ Конвертация</button></div>
<div class="row g-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Где хранится</th><th>Тип</th><th>Валюта</th><th class="text-end">На балансе</th><th></th></tr></thead><tbody>
      @foreach (var x in Model.Items) { <tr><td><strong>@(x.FinancialInstitution?.Name ?? x.Name)</strong></td><td><span class="badge bg-azure-lt">@organaizer.Pages.Balance.IndexModel.KindLabel(x.FinancialInstitution?.Kind ?? organaizer.Domain.InstitutionKind.Other)</span></td><td><span class="badge bg-indigo-lt">@x.Currency</span></td><td class="text-end fw-bold">@Model.Balances[x.Id].ToString("N2") @x.Currency</td><td class="text-end"><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#edit-@x.Id">Изменить</button></td></tr>
      <tr class="collapse" id="edit-@x.Id"><td colspan="5"><form method="post" asp-page-handler="Update" class="d-flex justify-content-end align-items-end gap-2"><input type="hidden" name="id" value="@x.Id"/><div><label class="form-label">Новая сумма</label><div class="input-group"><input name="amount" value="@x.OpeningBalance" type="number" step="0.00000001" class="form-control" required/><span class="input-group-text">@x.Currency</span></div></div><button class="btn btn-primary">Сохранить</button></form></td></tr> }
      @if (Model.Items.Count == 0) { <tr><td colspan="5" class="empty-state">Баланс пока не заполнен</td></tr> }
      </tbody></table></div>
    </div>
  </div>
  <div class="col-lg-4"><form method="post" class="card card-body"><h3 class="card-title">Добавить баланс</h3><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3"><label class="form-label">Кошелек, биржа или банк</label><select asp-for="Input.FinancialInstitutionId" asp-items="Model.Institutions" class="form-select"><option value="">Выберите...</option></select><span asp-validation-for="Input.FinancialInstitutionId" class="text-danger"></span><div class="form-hint">Нет нужного? <a asp-page="/Institutions/Index">Добавить в справочник</a></div></div>
    <div class="mb-3"><label class="form-label">Валюта</label><select asp-for="Input.Currency" asp-items="Model.Currencies" class="form-select"></select><span asp-validation-for="Input.Currency" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Сколько на балансе</label><input asp-for="Input.Amount" type="number" step="0.00000001" class="form-control"/><span asp-validation-for="Input.Amount" class="text-danger"></span></div>
    <button class="btn btn-primary">Добавить</button>
  </form></div>
</div>
<div class="modal" id="transfer-modal" tabindex="-1"><div class="modal-dialog"><form method="post" asp-page-handler="Transfer" class="modal-content"><div class="modal-header"><h3 class="modal-title">Перевод между счетами</h3><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Откуда</label><select name="fromAccountId" class="form-select" required>@foreach(var x in Model.Items){<option value="@x.Id">@(x.FinancialInstitution?.Name??x.Name) · @x.Currency · @Model.Balances[x.Id].ToString("N2")</option>}</select></div><div class="mb-3"><label class="form-label">Куда</label><select name="toAccountId" class="form-select" required>@foreach(var x in Model.Items){<option value="@x.Id">@(x.FinancialInstitution?.Name??x.Name) · @x.Currency</option>}</select></div><div class="mb-3"><label class="form-label">Сумма</label><input name="amount" type="number" min="0.00000001" step="0.00000001" class="form-control" required/></div><label class="form-label">Комментарий</label><input name="note" class="form-control"/></div><div class="modal-footer"><button type="button" class="btn btn-link" data-bs-dismiss="modal">Отмена</button><button class="btn btn-primary">Перевести</button></div></form></div></div>
<div class="modal" id="convert-modal" tabindex="-1"><div class="modal-dialog"><form method="post" asp-page-handler="Convert" class="modal-content"><div class="modal-header"><h3 class="modal-title">Конвертация в банке</h3><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Банк</label><select name="financialInstitutionId" id="conversion-bank" class="form-select" required><option value="">Выберите банк...</option>@foreach(var bank in Model.ConversionBanks){<option value="@bank.Id">@bank.Name</option>}</select><div class="form-hint">Показаны банки, где есть счета минимум в двух валютах</div></div><div class="mb-3"><label class="form-label">Списываем со счета</label><select name="fromAccountId" id="conversion-from" class="form-select" required disabled><option value="">Выерите счет...</option>@foreach(var x in Model.Items.Where(x=>x.FinancialInstitution?.Kind==organaizer.Domain.InstitutionKind.Bank)){<option value="@x.Id" data-bank="@x.FinancialInstitutionId" data-currency="@x.Currency">@x.Currency · @Model.Balances[x.Id].ToString("N2")</option>}</select></div><div class="mb-3"><label class="form-label">Зачисляем на счет</label><select name="toAccountId" id="conversion-to" class="form-select" required disabled><option value="">Выерите счет...</option>@foreach(var x in Model.Items.Where(x=>x.FinancialInstitution?.Kind==organaizer.Domain.InstitutionKind.Bank)){<option value="@x.Id" data-bank="@x.FinancialInstitutionId" data-currency="@x.Currency">@x.Currency</option>}</select></div><div class="row g-3"><div class="col-6"><label class="form-label">Списать</label><input name="fromAmount" type="number" min="0.00000001" step="0.00000001" class="form-control" required/></div><div class="col-6"><label class="form-label">Зачислить</label><input name="toAmount" type="number" min="0.00000001" step="0.00000001" class="form-control" required/></div></div><div class="mt-3"><label class="form-label">Комментарий / курс</label><input name="note" class="form-control"/></div></div><div class="modal-footer"><button type="button" class="btn btn-link" data-bs-dismiss="modal">Отмена</button><button class="btn btn-primary">Конвертировать</button></div></form></div></div>
<script>document.addEventListener('DOMContentLoaded',()=>{const bank=document.getElementById('conversion-bank'),from=document.getElementById('conversion-from'),to=document.getElementById('conversion-to');function filter(){const id=bank.value;[from,to].forEach(s=>{s.disabled=!id;s.value='';[...s.options].forEach((o,i)=>{if(i)o.hidden=o.dataset.bank!==id;});});}bank.addEventListener('change',filter);from.addEventListener('change',()=>{[...to.options].forEach((o,i)=>{if(i&&!o.hidden)o.disabled=o.dataset.currency===from.selectedOptions[0]?.dataset.currency;});});filter();});</script>
@if(TempData["BalanceError"] is string balanceError){<div class="modal" id="balance-error-modal" tabindex="-1"><div class="modal-dialog modal-sm"><div class="modal-content"><div class="modal-status bg-danger"></div><div class="modal-body text-center py-4"><div class="text-danger fs-1 mb-2">!</div><h3>Недостаточно средств</h3><div class="text-secondary">@balanceError</div></div><div class="modal-footer"><button class="btn btn-danger w-100" data-bs-dismiss="modal">Понятно</button></div></div></div></div><script>document.addEventListener('DOMContentLoaded',()=>new bootstrap.Modal(document.getElementById('balance-error-modal')).show());</script>}
