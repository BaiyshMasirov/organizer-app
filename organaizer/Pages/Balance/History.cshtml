@page
@model organaizer.Pages.Balance.HistoryModel
@{ ViewData["Title"] = "История движений"; }

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
  <div><h1 class="mb-1">История движений</h1><div class="text-secondary">@Model.AccountTitle</div></div>
  <div class="btn-list"><a asp-page-handler="Export" asp-route-accountId="@Model.AccountId" asp-route-type="@Model.Type" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-currency="@Model.Currency" class="btn btn-outline-success">↓ Выгрузить в Excel</a><a asp-page="/Balance/Index" class="btn btn-outline-secondary">← К балансу</a></div>
</div>

<form method="get" class="card card-body mb-4">
  @if(Model.AccountId.HasValue){<input type="hidden" asp-for="AccountId" />}
  <div class="row g-3 align-items-end">
    <div class="col-md-3"><label class="form-label">Тип операции</label><select asp-for="Type" class="form-select"><option value="">Все типы</option>@foreach(var type in Model.Types){<option value="@type">@type</option>}</select></div>
    <div class="col-md-2"><label class="form-label">Дата с</label><input asp-for="From" type="date" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label">Дата по</label><input asp-for="To" type="date" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label">Валюта</label><select asp-for="Currency" class="form-select"><option value="">Все валюты</option>@foreach(var currency in Model.Currencies){<option value="@currency">@currency</option>}</select></div>
    <div class="col-md-3"><div class="d-flex gap-2"><button class="btn btn-primary flex-fill" type="submit">Показать</button><a asp-page="/Balance/History" asp-route-accountId="@Model.AccountId" class="btn btn-outline-secondary">Сбросить</a></div></div>
  </div>
</form>

@if(Model.ShowPeriodSummary)
{
<div class="card mb-4">
  <div class="card-header"><div class="card-title">Сальдо за выбранный период</div></div>
  <div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Счёт</th><th>Валюта</th><th class="text-end">Сальдо на начало</th><th class="text-end">Приход</th><th class="text-end">Расход</th><th class="text-end">Сальдо на конец</th></tr></thead><tbody>
  @foreach(var x in Model.PeriodSummaries){<tr><td><strong>@x.Account</strong></td><td><span class="badge bg-indigo-lt">@x.Currency</span></td><td class="text-end">@x.Opening.ToString("N2")</td><td class="text-end text-success">@x.Income.ToString("N2")</td><td class="text-end text-danger">@x.Expense.ToString("N2")</td><td class="text-end fw-bold @(x.Closing<0?"text-danger":"")">@x.Closing.ToString("N2")</td></tr>}
  @if(Model.PeriodSummaries.Count==0){<tr><td colspan="6" class="empty-state">По заданным фильтрам счетов не найдено</td></tr>}
  </tbody></table></div>
</div>
}

<div class="card">
  <div class="card-header"><div class="card-title">Найдено движений: @Model.Items.Count</div></div>
  <div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Дата</th><th>Счёт</th><th>Тип операции</th><th>Описание</th><th class="text-end">Приход</th><th class="text-end">Расход</th><th>Валюта</th><th class="text-end">Остаток</th></tr></thead><tbody>
  @foreach(var x in Model.Items){<tr><td class="text-nowrap">@organaizer.Pages.Balance.HistoryModel.LocalDate(x.OccurredAt)</td><td><strong>@x.Account</strong></td><td><span class="badge bg-azure-lt">@x.Type</span></td><td>@(string.IsNullOrWhiteSpace(x.Description) ? "—" : x.Description)</td><td class="text-end fw-semibold text-success">@(x.Amount>0?x.Amount.ToString("N2"):"—")</td><td class="text-end fw-semibold text-danger">@(x.Amount<0?Math.Abs(x.Amount).ToString("N2"):"—")</td><td><span class="badge bg-indigo-lt">@x.Currency</span></td><td class="text-end fw-bold @(x.Balance<0?"text-danger":"")">@x.Balance.ToString("N2")</td></tr>}
  @if(Model.Items.Count==0){<tr><td colspan="8" class="empty-state">По заданным фильтрам движений не найдено</td></tr>}
  </tbody></table></div>
</div>
