@page
@model organaizer.Pages.Account.LoginModel
@{ Layout = null; ViewData["Title"] = "Вход"; }
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Вход · Finance Flow</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@@1.4.0/dist/css/tabler.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body class="login-body"><div class="login-shell"><section class="login-visual"><div class="login-brand"><span class="brand-mark">F</span><span>Finance <b>Flow</b></span></div><div class="login-copy"><span class="eyebrow">LIQUIDITY CONTROL</span><h1>Финансы двух компаний.<br/><em>Одна точка контроля.</em></h1><p>Операции, мультивалютные остатки, обязательства и прибыль в едином защищенном пространстве.</p></div><div class="login-orb orb-one"></div><div class="login-orb orb-two"></div></section>
<main class="login-panel"><div class="login-form"><div class="mb-4"><span class="eyebrow text-primary">SECURE WORKSPACE</span><h2 class="mt-2 mb-2">Добро пожаловать</h2><p class="text-secondary">Введите данные учетной записи</p></div><form method="post" asp-route-returnUrl="@Model.ReturnUrl"><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div><div class="mb-3"><label class="form-label">Логин</label><input asp-for="Input.UserName" class="form-control form-control-lg" autocomplete="username" autofocus/><span asp-validation-for="Input.UserName" class="text-danger"></span></div><div class="mb-3"><label class="form-label">Пароль</label><input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="current-password"/><span asp-validation-for="Input.Password" class="text-danger"></span></div><label class="form-check mb-4"><input asp-for="Input.RememberMe" class="form-check-input"/><span class="form-check-label">Оставаться в системе</span></label><button class="btn btn-primary btn-lg w-100">Войти в систему →</button></form><div class="login-security">● Защищенное соединение · Сессия до 12 часов</div></div></main></div>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script><script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script></body></html>
