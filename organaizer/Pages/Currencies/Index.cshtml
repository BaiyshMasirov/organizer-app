@page
@model organaizer.Pages.Currencies.IndexModel
@{ViewData["Title"]="Валюты";}
<div class="mb-4"><h1 class="mb-1">Справочник валют</h1><div class="text-secondary">Валюты доступны во всех выпадающих списках операций</div></div><div class="row g-4"><div class="col-lg-7"><div class="card"><table class="table table-vcenter mb-0"><thead><tr><th>Код</th><th>Название</th><th>Символ</th><th>Точность</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><span class="currency-token">@x.Code</span></td><td>@x.Name</td><td class="fs-3">@x.Symbol</td><td>@x.Precision знаков</td></tr>}</tbody></table></div></div><div class="col-lg-5"><form method="post" class="card card-body"><h3 class="card-title">Добавить валюту</h3><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-4"><label class="form-label">Код</label><input asp-for="Input.Code" class="form-control" placeholder="GBP"/></div><div class="col-8"><label class="form-label">Название</label><input asp-for="Input.Name" class="form-control"/></div><div class="col-6"><label class="form-label">Символ</label><input asp-for="Input.Symbol" class="form-control"/></div><div class="col-6"><label class="form-label">Знаков после запятой</label><input asp-for="Input.Precision" class="form-control"/></div><div class="col-12"><button class="btn btn-primary w-100">Добавить в справочник</button></div></div></form></div></div>
