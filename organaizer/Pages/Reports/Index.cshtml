@page
@model organaizer.Pages.Reports.IndexModel
@{ViewData["Title"]="Промежуточный отчет";}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="mb-1">Промежуточный отчет</h1><div class="text-secondary">Аналог итогового блока таблицы ликвидности</div></div><span class="badge bg-indigo-lt fs-5">@Model.Period</span></div>
<form method="get" class="card card-body mb-4"><div class="row g-2"><div class="col-md-4"><label class="form-label">Компания</label><select name="companyId" class="form-select"><option value="">Все компании</option>@foreach(var c in Model.Companies){<option value="@c.Id" selected="@(Model.CompanyId==c.Id)">@c.Name</option>}</select></div><div class="col-md-2"><label class="form-label">Год</label><input name="year" value="@Model.Year" type="number" min="2000" max="2100" class="form-control"/></div><div class="col-md-3"><label class="form-label">Месяц</label><select name="month" class="form-select"><option value="">Весь год</option>@for(var m=1;m<=12;m++){<option value="@m" selected="@(Model.Month==m)">@System.Globalization.CultureInfo.GetCultureInfo("ru-RU").DateTimeFormat.GetMonthName(m)</option>}</select></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100">Сформировать отчет</button></div></div></form>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric"><span>Прибыль по операциям</span><strong>@Model.Report.Profit.ToString("N2") USDT</strong></div></div><div class="col-md-4"><div class="metric"><span>Расходы</span><strong class="text-danger">@Model.Report.Expenses.ToString("N2") USDT</strong></div></div><div class="col-md-4"><div class="metric accent"><span>Финансовый результат</span><strong>@Model.Report.NetProfit.ToString("N2") USDT</strong></div></div></div>
<div class="card mb-4"><div class="card-header">@Model.ChartTitle</div><div class="card-body chart-wrap"><canvas id="profitChart"></canvas></div></div>
<div class="card mb-4"><div class="card-header">Итоги покупки и продажи</div><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Операция</th><th>Сделок</th><th>Получили</th><th>Отдали</th><th class="text-end">Расходы, USDT</th><th class="text-end">Прибыль, USDT</th></tr></thead><tbody>@foreach(var x in Model.Report.Operations){<tr><td>@organaizer.Domain.OperationTypes.All.GetValueOrDefault(x.TypeCode,x.TypeCode)</td><td>@x.Count</td><td>@x.BuyAmount.ToString("N2") @x.BuyCurrency</td><td>@x.SellAmount.ToString("N2") @x.SellCurrency</td><td class="text-end text-danger">@x.Expenses.ToString("N2")</td><td class="text-end @(x.Profit<0?"text-danger":"text-success")">@x.Profit.ToString("N2")</td></tr>}@if(Model.Report.Operations.Count==0){<tr><td colspan="6" class="empty-state">За выбранный период операций нет</td></tr>}</tbody></table></div></div>
<div class="card"><div class="card-header">Движение по валютам</div><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Валюта</th><th class="text-end">Приход</th><th class="text-end">Расход</th><th class="text-end">Разница</th><th class="text-end">Прибыль, USDT</th></tr></thead><tbody>@foreach(var x in Model.Report.Flows){<tr><td><span class="currency-token">@x.Currency</span></td><td class="text-end">@x.Incoming.ToString("N2")</td><td class="text-end">@x.Outgoing.ToString("N2")</td><td class="text-end fw-bold @(x.Net<0?"text-danger":"text-success")">@x.Net.ToString("N2")</td><td class="text-end fw-bold @(x.ProfitUsd<0?"text-danger":"text-success")">@x.ProfitUsd.ToString("N2")</td></tr>}</tbody></table></div></div>
@if(Model.Report.Balances.Count>0){<div class="card mt-4"><div class="card-header">Сальдо</div><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Валюта</th><th class="text-end">На начало</th><th class="text-end">На конец</th><th class="text-end">На начало, USDT</th><th class="text-end">На конец, USDT</th></tr></thead><tbody>@foreach(var x in Model.Report.Balances){<tr><td><span class="currency-token">@x.Currency</span></td><td class="text-end">@x.Opening.ToString("N2")</td><td class="text-end">@x.Closing.ToString("N2")</td><td class="text-end">@x.OpeningUsdt.ToString("N2")</td><td class="text-end fw-bold">@x.ClosingUsdt.ToString("N2")</td></tr>}</tbody></table></div></div>}
@section Scripts{<script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.7/dist/chart.umd.min.js"></script><script>new Chart(document.getElementById('profitChart'),{type:'bar',data:{labels:@Html.Raw(Model.ChartLabels),datasets:[{label:'Прибыль, USDT',data:@Html.Raw(Model.ChartValues),backgroundColor:ctx=>ctx.raw<0?'#ef4444':'#4f46e5',borderRadius:7}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>`${Number(ctx.raw).toLocaleString('ru-RU',{minimumFractionDigits:2})} USDT`}}},scales:{x:{grid:{display:false}},y:{beginAtZero:true,grid:{color:'#e9edf4'},ticks:{callback:value=>Number(value).toLocaleString('ru-RU')}}}}});</script>}
