@page
@model organaizer.Pages.Operations.CreateModel
@{ViewData["Title"]="Новая операция";}
<h1 class="mb-1">Новая операция</h1>@if(Model.IsCopy){<div class="text-secondary mb-4">Данные скопированы. После сохранения будет создана отдельная новая операция.</div>}else{<div class="mb-4"></div>}<form method="post" class="card card-body" id="operation-form" data-copy="@Model.IsCopy.ToString().ToLowerInvariant()"><div asp-validation-summary="All" class="alert alert-danger"></div><input asp-for="Input.SellCurrency" type="hidden"/><input asp-for="Input.BuyCurrency" type="hidden"/><div class="row g-3">
<div class="col-md-6"><label class="form-label">Компания</label><select asp-for="Input.CompanyId" asp-items="Model.Companies" class="form-select"></select></div><div class="col-md-6"><label class="form-label">Клиент / партнер</label><select asp-for="Input.CounterpartyId" asp-items="Model.Counterparties" class="form-select"><option value="">Без контрагента</option></select></div>
<div class="col-md-8"><label class="form-label">Валютная пара</label><select asp-for="Input.TypeCode" class="form-select">@foreach(var x in Model.Types){<option value="@x.Key" data-sell="@organaizer.Domain.OperationTypes.Pair(x.Key).Sell" data-buy="@organaizer.Domain.OperationTypes.Pair(x.Key).Buy">@organaizer.Domain.OperationTypes.PairLabel(x.Key) · @x.Value</option>}</select></div><div class="col-md-4"><label class="form-label">Дата</label><input asp-for="Input.OccurredAt" type="date" class="form-control"></div>
<div class="col-md-3"><label class="form-label">Отдаём</label><input id="sell-currency-view" class="form-control" readonly/></div><div class="col-md-3"><label class="form-label">Сумма отдаём</label><input id="sell-amount-view" class="form-control grouped-number" inputmode="decimal" autocomplete="off"/><input asp-for="Input.SellAmount" type="hidden"/></div><div class="col-md-3"><label class="form-label">Получаем</label><input id="buy-currency-view" class="form-control" readonly/></div><div class="col-md-3"><label class="form-label">Сумма получаем</label><input id="buy-amount-view" class="form-control grouped-number" inputmode="decimal" autocomplete="off"/><input asp-for="Input.BuyAmount" type="hidden"/></div>
<div class="col-md-4"><label class="form-label">Курс операции</label><input asp-for="Input.ExchangeRate" type="number" class="form-control" min="0" step="any" inputmode="decimal" placeholder="Автоматически или вручную"><div id="rate-hint" class="form-hint"></div></div><div class="col-md-2"><label class="form-label">Комиссия</label><input asp-for="Input.FeeAmount" class="form-control"></div><div class="col-md-2"><label class="form-label">Валюта комиссии</label><select asp-for="Input.FeeCurrency" asp-items="Model.Currencies" class="form-select"></select></div><div class="col-md-2"><label class="form-label">Прибыль USD</label><input asp-for="Input.BaseCurrencyProfit" class="form-control"></div><div class="col-md-2"><label class="form-label">Срок расчета</label><input asp-for="Input.DueAt" type="date" class="form-control"></div>
<div class="col-md-6"><label class="form-label">Счёт списания <span id="sell-account-currency"></span></label><select asp-for="Input.SellAccountId" class="form-select account-select"><option value="">Выберите счёт...</option>@foreach(var a in Model.AccountItems){<option value="@a.Id" data-currency="@a.Currency" data-kind="@a.FinancialInstitution?.Kind" data-balance="@Model.AccountBalances[a.Id].ToString(System.Globalization.CultureInfo.InvariantCulture)">@(a.FinancialInstitution?.Name??a.Name) · @a.Currency · @Model.AccountBalances[a.Id].ToString("N2")</option>}</select><span asp-validation-for="Input.SellAccountId" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Счёт зачисления <span id="buy-account-currency"></span></label><select asp-for="Input.BuyAccountId" class="form-select account-select"><option value="">Выберите счёт...</option>@foreach(var a in Model.AccountItems){<option value="@a.Id" data-currency="@a.Currency" data-kind="@a.FinancialInstitution?.Kind">@(a.FinancialInstitution?.Name??a.Name) · @a.Currency</option>}</select><span asp-validation-for="Input.BuyAccountId" class="text-danger"></span></div>
<div class="col-12"><label class="form-label">Комментарий</label><textarea asp-for="Input.Note" class="form-control"></textarea></div><div class="col-12"><button class="btn btn-primary">Сохранить</button> <a asp-page="Index" class="btn btn-light">Отмена</a></div></div></form>
<div class="modal" id="balance-confirm-modal" tabindex="-1"><div class="modal-dialog modal-sm modal-dialog-centered"><div class="modal-content"><div class="modal-status bg-warning"></div><div class="modal-body text-center py-4"><h3>Недостаточно средств</h3><p id="balance-confirm-message" class="text-secondary"></p><p class="mb-0">Вы уверены, что хотите сохранить операцию?</p></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Нет</button><button type="button" class="btn btn-warning" id="confirm-insufficient-balance">Да, сохранить</button></div></div></div></div>
<script>document.addEventListener('DOMContentLoaded',()=>{const form=document.getElementById('operation-form'),isCopy=form.dataset.copy==='true',type=document.getElementById('Input_TypeCode'),sell=document.getElementById('Input_SellCurrency'),buy=document.getElementById('Input_BuyCurrency'),sellView=document.getElementById('sell-currency-view'),buyView=document.getElementById('buy-currency-view'),sellAmount=document.getElementById('Input_SellAmount'),buyAmount=document.getElementById('Input_BuyAmount'),sellAmountView=document.getElementById('sell-amount-view'),buyAmountView=document.getElementById('buy-amount-view'),rate=document.getElementById('Input_ExchangeRate'),date=document.getElementById('Input_OccurredAt'),hint=document.getElementById('rate-hint'),sellAccount=document.getElementById('Input_SellAccountId'),buyAccount=document.getElementById('Input_BuyAccountId'),balanceModal=new bootstrap.Modal(document.getElementById('balance-confirm-modal')),balanceMessage=document.getElementById('balance-confirm-message');let insufficientBalanceConfirmed=false;const parse=v=>Number(String(v).replace(/\s/g,'').replace(',','.'))||0,format=v=>v?Number(v).toLocaleString('ru-RU',{maximumFractionDigits:8}):'';function filter(select,currency){[...select.options].forEach((o,i)=>{if(!i)return;o.hidden=o.dataset.currency!==currency||(currency==='USDT'&&!['Wallet','Exchange','PaymentSystem'].includes(o.dataset.kind));});if(select.selectedOptions[0]?.hidden)select.value='';}function pair(refreshRate=true){const o=type.selectedOptions[0];sell.value=o.dataset.sell;buy.value=o.dataset.buy;sellView.value=sell.value;buyView.value=buy.value;document.getElementById('sell-account-currency').textContent='· '+sell.value;document.getElementById('buy-account-currency').textContent='· '+buy.value;filter(sellAccount,sell.value);filter(buyAccount,buy.value);if(refreshRate)loadRate();}async function loadRate(){const q=new URLSearchParams({handler:'Rate',sellCurrency:sell.value,buyCurrency:buy.value,date:date.value});const d=await(await fetch('?'+q)).json();if(d.found){rate.value=Number(d.rate).toFixed(8);hint.textContent='Курс из справочника';calcBuy();}else{rate.value='';hint.textContent='Курса нет — введите его вручную';}}function calcRate(){const s=parse(sellAmountView.value),b=parse(buyAmountView.value);sellAmount.value=s;buyAmount.value=b;if(s&&b){rate.value=(b/s).toFixed(12);hint.textContent='Курс рассчитан по двум суммам';}}function calcBuy(){const s=parse(sellAmountView.value),r=parse(rate.value);sellAmount.value=s;if(s&&r){const b=s*r;buyAmount.value=b;buyAmountView.value=format(b);}}sellAmountView.value=format(sellAmount.value);buyAmountView.value=format(buyAmount.value);sellAmountView.addEventListener('input',()=>{sellAmount.value=parse(sellAmountView.value);calcBuy();insufficientBalanceConfirmed=false;});buyAmountView.addEventListener('input',calcRate);[sellAmountView,buyAmountView].forEach(x=>x.addEventListener('blur',()=>x.value=format(parse(x.value))));rate.addEventListener('input',calcBuy);type.addEventListener('change',()=>pair(true));date.addEventListener('change',loadRate);sellAccount.addEventListener('change',()=>insufficientBalanceConfirmed=false);form.addEventListener('submit',event=>{const amount=parse(sellAmountView.value),option=sellAccount.selectedOptions[0],available=parse(option?.dataset.balance);sellAmount.value=amount;buyAmount.value=parse(buyAmountView.value);if(option?.value&&amount>available&&!insufficientBalanceConfirmed){event.preventDefault();balanceMessage.textContent=`На счёте доступно ${available.toLocaleString('ru-RU',{maximumFractionDigits:8})} ${sell.value}, требуется ${amount.toLocaleString('ru-RU',{maximumFractionDigits:8})} ${sell.value}.`;balanceModal.show();}});document.getElementById('confirm-insufficient-balance').addEventListener('click',()=>{insufficientBalanceConfirmed=true;balanceModal.hide();form.requestSubmit();});pair(!isCopy);if(isCopy)hint.textContent='Курс скопирован из исходной операции';});</script>
