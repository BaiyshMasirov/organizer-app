@page
@model organaizer.Pages.Operations.CreateModel
@{ViewData["Title"]="Новая операция";}

<style>
  .operation-panel{height:100%;border:1px solid #dfe5ef;border-radius:16px;padding:20px;background:#fff;box-shadow:0 4px 18px rgba(31,42,68,.05)}
  .operation-panel.send{border-top:4px solid #f59f00}.operation-panel.receive{border-top:4px solid #2fb344}
  .operation-panel h3{display:flex;align-items:center;gap:10px;margin:0 0 18px;font-size:18px}
  .operation-panel .direction{display:inline-flex;width:30px;height:30px;align-items:center;justify-content:center;border-radius:50%;font-size:18px}
  .operation-panel.send .direction{color:#b26a00;background:#fff4d6}.operation-panel.receive .direction{color:#178332;background:#e5f7e9}
  .operation-summary{border:1px solid #ccd8f2;border-radius:16px;padding:20px;background:linear-gradient(135deg,#f7f9ff,#eef3ff)}
  .operation-summary h3{margin:0 0 18px;font-size:18px;color:#1d3472}
  .balance-confirm-overlay{position:fixed;inset:0;z-index:2000;display:flex;align-items:center;justify-content:center;padding:1rem;background:rgba(15,23,42,.55)}
  .balance-confirm-dialog{width:min(440px,100%)}
</style>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div><h1 class="mb-1">Новая операция</h1>@if(Model.IsCopy){<div class="text-secondary">Данные скопированы. После сохранения будет создана отдельная операция.</div>}</div>
  <a asp-page="Index" class="btn btn-light">Отмена</a>
</div>

<form method="post" class="card card-body" id="operation-form" data-copy="@Model.IsCopy.ToString().ToLowerInvariant()">
  @if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="alert alert-danger"></div>}
  <input asp-for="Input.SellCurrency" type="hidden"/>
  <input asp-for="Input.BuyCurrency" type="hidden"/>
  <div class="row g-3 mb-4">
    <div class="col-md-6"><label class="form-label">Компания</label><select asp-for="Input.CompanyId" asp-items="Model.Companies" class="form-select"></select></div>
    <div class="col-md-6"><label class="form-label">Клиент / партнёр</label><select asp-for="Input.CounterpartyId" asp-items="Model.Counterparties" class="form-select"><option value="">Без контрагента</option></select></div>
    <div class="col-lg-6"><label class="form-label">Тип операции</label><select asp-for="Input.TypeCode" class="form-select">@foreach(var x in Model.Types){<option value="@x.Key" data-sell="@organaizer.Domain.OperationTypes.Pair(x.Key).Sell" data-buy="@organaizer.Domain.OperationTypes.Pair(x.Key).Buy">@organaizer.Domain.OperationTypes.PairLabel(x.Key) · @x.Value</option>}</select></div>
    <div class="col-md-3"><label class="form-label">Дата</label><input asp-for="Input.OccurredAt" type="date" class="form-control"></div>
    <div class="col-md-3"><label class="form-label">Срок расчёта</label><input asp-for="Input.DueAt" type="date" class="form-control"></div>
  </div>
  <div class="row g-4">
    <div class="col-lg-6"><section class="operation-panel send"><h3><span class="direction">↑</span> Отдаём</h3><div class="row g-3">
      <div class="col-md-7"><label class="form-label">Сумма</label><input id="sell-amount-view" class="form-control grouped-number" inputmode="decimal" autocomplete="off"><input asp-for="Input.SellAmount" type="hidden"></div>
      <div class="col-md-5"><label class="form-label">Валюта</label><input id="sell-currency-view" class="form-control" readonly></div>
      <div class="col-12"><label class="form-label">Откуда отправляем <span id="sell-account-currency"></span></label><select asp-for="Input.SellAccountId" class="form-select account-select"><option value="">Выберите счёт...</option>@foreach(var a in Model.AccountItems){<option value="@a.Id" data-currency="@a.Currency" data-kind="@a.FinancialInstitution?.Kind" data-balance="@Model.AccountBalances[a.Id].ToString(System.Globalization.CultureInfo.InvariantCulture)">@(a.FinancialInstitution?.Name??a.Name) · @a.Currency · @Model.AccountBalances[a.Id].ToString("N2")</option>}</select><span asp-validation-for="Input.SellAccountId" class="text-danger"></span></div>
    </div></section></div>
    <div class="col-lg-6"><section class="operation-panel receive"><h3><span class="direction">↓</span> Получаем</h3><div class="row g-3">
      <div class="col-md-7"><label class="form-label">Сумма</label><input id="buy-amount-view" class="form-control grouped-number" inputmode="decimal" autocomplete="off"><input asp-for="Input.BuyAmount" type="hidden"></div>
      <div class="col-md-5"><label class="form-label">Валюта</label><input id="buy-currency-view" class="form-control" readonly></div>
      <div class="col-12"><label class="form-label">Куда получаем <span id="buy-account-currency"></span></label><select asp-for="Input.BuyAccountId" class="form-select account-select"><option value="">Выберите счёт...</option>@foreach(var a in Model.AccountItems){<option value="@a.Id" data-currency="@a.Currency" data-kind="@a.FinancialInstitution?.Kind">@(a.FinancialInstitution?.Name??a.Name) · @a.Currency</option>}</select><span asp-validation-for="Input.BuyAccountId" class="text-danger"></span></div>
    </div></section></div>
  </div>
  <section class="operation-summary mt-4"><h3>Итог операции</h3><div class="row g-3">
    <div class="col-md-6 col-xl-3"><label class="form-label">Комиссия</label><input asp-for="Input.FeeAmount" class="form-control"></div>
    <div class="col-md-6 col-xl-3"><label class="form-label">Валюта комиссии</label><select asp-for="Input.FeeCurrency" asp-items="Model.Currencies" class="form-select"></select></div>
    <div class="col-md-6 col-xl-3"><label class="form-label">Курс комиссии к USD</label><input asp-for="Input.ExchangeRate" type="text" inputmode="decimal" class="form-control" placeholder="Из справочника или вручную"><div id="rate-hint" class="form-hint"></div></div>
    <div class="col-md-6 col-xl-3"><label class="form-label">Прибыль USD</label><input asp-for="Input.BaseCurrencyProfit" class="form-control"><div id="profit-hint" class="form-hint"></div><span asp-validation-for="Input.BaseCurrencyProfit" class="text-danger"></span></div>
    <div class="col-12"><label class="form-label">Комментарий</label><textarea asp-for="Input.Note" class="form-control" rows="2"></textarea></div>
  </div></section>
  <div class="mt-4"><button class="btn btn-primary">Сохранить операцию</button></div>
</form>

<div class="balance-confirm-overlay" id="balance-error-modal" hidden="@(Model.BalanceError is null ? "hidden" : null)"><div class="card border-0 shadow-lg balance-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="balance-error-title"><div class="modal-status bg-warning"></div><div class="card-body text-center py-4"><h3 id="balance-error-title">Недостаточно средств</h3><p class="text-secondary" id="balance-error-message">@Model.BalanceError</p><div class="d-flex gap-2"><button type="button" class="btn btn-light w-50" onclick="document.getElementById('balance-error-modal').hidden=true">Нет</button><button type="submit" form="operation-form" name="ConfirmInsufficientFunds" value="true" class="btn btn-warning w-50">Да, сохранить</button></div></div></div></div>

<script>document.addEventListener('DOMContentLoaded',()=>{const form=document.getElementById('operation-form'),type=document.getElementById('Input_TypeCode'),sell=document.getElementById('Input_SellCurrency'),buy=document.getElementById('Input_BuyCurrency'),sellView=document.getElementById('sell-currency-view'),buyView=document.getElementById('buy-currency-view'),sellAmount=document.getElementById('Input_SellAmount'),buyAmount=document.getElementById('Input_BuyAmount'),sellAmountView=document.getElementById('sell-amount-view'),buyAmountView=document.getElementById('buy-amount-view'),sellAccount=document.getElementById('Input_SellAccountId'),buyAccount=document.getElementById('Input_BuyAccountId');const parse=v=>Number(String(v).replace(/\s/g,'').replace(',','.'))||0,format=v=>v?Number(v).toLocaleString('ru-RU',{maximumFractionDigits:8}):'';function filter(select,currency){[...select.options].forEach((o,i)=>{if(!i)return;o.hidden=o.dataset.currency!==currency||(currency==='USDT'&&!['Wallet','Exchange','PaymentSystem'].includes(o.dataset.kind));});if(select.selectedOptions[0]?.hidden)select.value='';}function pair(){const o=type.selectedOptions[0];sell.value=o.dataset.sell;buy.value=o.dataset.buy;sellView.value=sell.value;buyView.value=buy.value;document.getElementById('sell-account-currency').textContent='· '+sell.value;document.getElementById('buy-account-currency').textContent='· '+buy.value;filter(sellAccount,sell.value);filter(buyAccount,buy.value);}sellAmountView.value=format(sellAmount.value);buyAmountView.value=format(buyAmount.value);sellAmountView.addEventListener('input',()=>sellAmount.value=parse(sellAmountView.value));buyAmountView.addEventListener('input',()=>buyAmount.value=parse(buyAmountView.value));[sellAmountView,buyAmountView].forEach(x=>x.addEventListener('blur',()=>x.value=format(parse(x.value))));type.addEventListener('change',pair);form.addEventListener('submit',()=>{sellAmount.value=parse(sellAmountView.value);buyAmount.value=parse(buyAmountView.value);});pair();});</script>
<script>document.addEventListener('DOMContentLoaded',()=>{const form=document.getElementById('operation-form'),account=document.getElementById('Input_SellAccountId'),amount=document.getElementById('sell-amount-view'),currency=document.getElementById('Input_SellCurrency'),overlay=document.getElementById('balance-error-modal'),message=document.getElementById('balance-error-message'),number=v=>Number(String(v).replace(/[\s ]/g,'').replace(',','.'))||0,format=v=>v.toLocaleString('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:8});form.addEventListener('submit',event=>{if(event.submitter?.name==='ConfirmInsufficientFunds')return;const option=account.selectedOptions[0],required=number(amount.value),available=number(option?.dataset.balance);if(option?.value&&required>available){event.preventDefault();message.textContent=`На счёте «${option.textContent.split(' · ')[0]}» доступно ${format(available)} ${currency.value}, а нужно ${format(required)} ${currency.value}. Вы уверены, что хотите сохранить операцию?`;overlay.hidden=false;}});});</script>
<script>document.addEventListener('DOMContentLoaded',()=>{const fee=document.getElementById('Input_FeeAmount'),currency=document.getElementById('Input_FeeCurrency'),date=document.getElementById('Input_OccurredAt'),rate=document.getElementById('Input_ExchangeRate'),profit=document.getElementById('Input_BaseCurrencyProfit'),rateHint=document.getElementById('rate-hint'),profitHint=document.getElementById('profit-hint');const number=v=>Number(String(v).replace(/[\s ]/g,'').replace(',','.'))||0,normalize=x=>x.value=number(x.value).toString();function calculate(){if(date.value<'2026-09-01'){profitHint.textContent='Для операций до 01.09.2026 действует исторический расчёт';return;}profit.value=(number(fee.value)*number(rate.value)).toFixed(2);profitHint.textContent='Комиссия × курс к USD';}async function load(){const q=new URLSearchParams({handler:'ProfitRate',currency:currency.value,date:date.value});const d=await(await fetch('?'+q)).json();rate.value=d.found?Number(d.rate).toFixed(8):'0';rateHint.textContent=d.found?'Курс '+d.source+' через KGS на дату операции':'Курс не найден';calculate();}[currency,date].forEach(x=>x.addEventListener('change',load));[fee,rate].forEach(x=>x.addEventListener('input',calculate));rate.form.addEventListener('submit',()=>[fee,rate,profit].forEach(normalize));load();});</script>
