@page "{id:guid}"
@model organaizer.Pages.Operations.DetailsModel
@{ViewData["Title"]="Просмотр операции";var x=Model.Operation;}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="mb-1">Операция</h1><div class="text-secondary">@x.Id</div></div><div class="btn-list"><a asp-page="Edit" asp-route-id="@x.Id" class="btn btn-icon btn-primary" title="Изменить">✎</a>@if(x.Status!=organaizer.Domain.OperationStatus.Settled&&x.Status!=organaizer.Domain.OperationStatus.Cancelled){<form method="post" asp-page-handler="Complete" asp-route-id="@x.Id" onsubmit="return confirm('Подтвердить завершение операции?');"><button class="btn btn-icon btn-success" title="Завершить">✓</button></form>}@if(x.Status!=organaizer.Domain.OperationStatus.Cancelled){<form method="post" asp-page-handler="Cancel" asp-route-id="@x.Id" onsubmit="return confirm('Отменить операцию? Она останется в истории.');"><button class="btn btn-icon btn-outline-danger" title="Отменить">✕</button></form>}<a asp-page="Index" class="btn btn-icon btn-ghost-secondary" title="К списку">←</a></div></div>
<div class="row g-4"><div class="col-lg-8"><div class="card"><div class="card-header"><span>@organaizer.Domain.OperationTypes.All.GetValueOrDefault(x.TypeCode,x.TypeCode)</span><span class="badge @(x.Status==organaizer.Domain.OperationStatus.Cancelled?"bg-secondary-lt":x.Status==organaizer.Domain.OperationStatus.Settled?"bg-green-lt":"bg-blue-lt") ms-auto">@organaizer.Domain.OperationStatuses.Label(x.Status)</span></div><div class="card-body"><div class="operation-flow"><div><small>ОТДАЕМ</small><strong>@x.SellAmount.ToString("N2")</strong><span class="currency-token">@x.SellCurrency</span></div><div class="flow-arrow">→</div><div><small>ПОЛУЧАЕМ</small><strong>@x.BuyAmount.ToString("N2")</strong><span class="currency-token">@x.BuyCurrency</span></div></div><div class="detail-grid mt-4"><div><small>Дата операции</small><strong>@x.OccurredAt.ToString("dd.MM.yyyy HH:mm")</strong></div><div><small>Срок расчета</small><strong>@(x.DueAt?.ToString("dd.MM.yyyy")??"—")</strong></div><div><small>Компания</small><strong>@Model.Company.Name</strong></div><div><small>Клиент</small><strong>@(x.Counterparty?.Name??"—")</strong></div><div><small>Комиссия</small><strong>@x.FeeAmount.ToString("N2") @x.FeeCurrency</strong></div><div><small>Прибыль</small><strong class="@(x.BaseCurrencyProfit<0?"text-danger":"text-success")">@x.BaseCurrencyProfit.ToString("N2") USD</strong></div></div>@if(!string.IsNullOrWhiteSpace(x.Note)){<div class="note-box mt-4"><small>Комментарий</small><div>@x.Note</div></div>}</div></div></div>
<div class="col-lg-4"><div class="card mb-4"><div class="card-header">Банки и каналы</div><div class="card-body"><div class="detail-grid"><div><small>Получаем через</small><strong>@(x.SourceAccount??"—")</strong></div><div><small>Отправляем через</small><strong>@(x.DestinationAccount??"—")</strong></div></div></div></div><div class="card"><div class="card-header">Частичные расчеты <span class="badge bg-secondary-lt ms-auto">@x.Settlements.Count</span></div><div class="list-group list-group-flush">@foreach(var s in x.Settlements.OrderByDescending(s=>s.OccurredAt)){<div class="list-group-item"><div class="d-flex justify-content-between"><strong>@s.Amount.ToString("N2") @s.Currency</strong><span class="text-secondary">@s.OccurredAt.ToString("dd.MM.yy")</span></div><div class="small text-secondary">@(s.Account?.Name??"Счет")</div></div>}@if(x.Settlements.Count==0){<div class="empty-state">Расчетов пока нет</div>}</div></div></div></div>
