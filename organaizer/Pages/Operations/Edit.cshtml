@page "{id:guid}"
@model organaizer.Pages.Operations.EditModel
@{ViewData["Title"]="Редактирование операции";}
<div class="d-flex justify-content-between align-items-center mb-4"><h1>Редактирование операции</h1><a asp-page="Details" asp-route-id="@Model.Input.Id" class="btn btn-ghost-secondary">Отмена</a></div><form method="post" class="card card-body"><input asp-for="Input.Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3">
<div class="col-md-6"><label class="form-label">Компания</label><select asp-for="Input.CompanyId" asp-items="Model.Companies" class="form-select"></select></div><div class="col-md-6"><label class="form-label">Клиент / партнер</label><select asp-for="Input.CounterpartyId" asp-items="Model.Counterparties" class="form-select"><option value="">Без контрагента</option></select></div><div class="col-12"><label class="form-label">Тип операции</label><select asp-for="Input.TypeCode" class="form-select">@foreach(var t in Model.Types){<option value="@t.Key">@t.Value</option>}</select></div>
<div class="col-md-3"><label class="form-label">Дата</label><input asp-for="Input.OccurredAt" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">Срок расчета</label><input asp-for="Input.DueAt" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">Отдаем</label><input asp-for="Input.SellAmount" class="form-control"/></div><div class="col-md-3"><label class="form-label">Валюта</label><select asp-for="Input.SellCurrency" asp-items="Model.Currencies" class="form-select"></select></div><div class="col-md-3"><label class="form-label">Получаем</label><input asp-for="Input.BuyAmount" class="form-control"/></div><div class="col-md-3"><label class="form-label">Валюта</label><select asp-for="Input.BuyCurrency" asp-items="Model.Currencies" class="form-select"></select></div><div class="col-md-3"><label class="form-label">Комиссия</label><input asp-for="Input.FeeAmount" class="form-control"/></div><div class="col-md-3"><label class="form-label">Валюта комиссии</label><select asp-for="Input.FeeCurrency" asp-items="Model.Currencies" class="form-select"></select></div><div class="col-md-6"><label class="form-label">Откуда получаем</label><select asp-for="Input.SourceAccount" asp-items="Model.Institutions" class="form-select"><option value="">Не выбран</option></select></div><div class="col-md-6"><label class="form-label">Откуда отправляем</label><select asp-for="Input.DestinationAccount" asp-items="Model.Institutions" class="form-select"><option value="">Не выбран</option></select></div><div class="col-md-4"><label class="form-label">Прибыль USD</label><input asp-for="Input.BaseCurrencyProfit" class="form-control"/></div><div class="col-md-8"><label class="form-label">Комментарий</label><input asp-for="Input.Note" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">Сохранить изменения</button></div></div></form>
