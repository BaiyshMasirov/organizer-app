@page "{id:guid}"
@model organaizer.Pages.Operations.EditModel
@{ViewData["Title"]="Редактирование операции";}

<style>
  .operation-panel{height:100%;border:1px solid #dfe5ef;border-radius:16px;padding:20px;background:#fff;box-shadow:0 4px 18px rgba(31,42,68,.05)}
  .operation-panel.send{border-top:4px solid #f59f00}.operation-panel.receive{border-top:4px solid #2fb344}
  .operation-panel h3{display:flex;align-items:center;gap:10px;margin:0 0 18px;font-size:18px}
  .operation-panel .direction{display:inline-flex;width:40px;height:40px;align-items:center;justify-content:center;border-radius:50%;font-size:24px}
  .operation-panel.send .direction{color:#b26a00;background:#fff4d6}.operation-panel.receive .direction{color:#178332;background:#e5f7e9}
  .operation-summary{border:1px solid #ccd8f2;border-radius:16px;padding:20px;background:linear-gradient(135deg,#f7f9ff,#eef3ff)}
  .operation-summary h3{margin:0 0 18px;font-size:18px;color:#1d3472}
</style>

<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="mb-0">Редактирование операции</h1><a asp-page="Details" asp-route-id="@Model.Input.Id" class="btn btn-light">Отмена</a></div>

<form method="post" class="card card-body" id="operation-form" data-aa="@Model.IsLiquidityProvider.ToString().ToLowerInvariant()">
  <input asp-for="Input.Id" type="hidden"/><input asp-for="Input.SellCurrency" type="hidden"/><input asp-for="Input.BuyCurrency" type="hidden"/>
  <div asp-validation-summary="All" class="alert alert-danger"></div>
  <div class="row g-3 mb-4">
    <div class="col-md-6"><label class="form-label">Компания</label><select asp-for="Input.CompanyId" asp-items="Model.Companies" class="form-select"></select></div>
    <div class="col-md-6"><label class="form-label">Клиент / партнёр</label><select asp-for="Input.CounterpartyId" asp-items="Model.Counterparties" class="form-select"><option value="">Без контрагента</option></select></div>
    <div class="col-lg-6"><label class="form-label">Тип операции</label><select asp-for="Input.TypeCode" class="form-select">@foreach(var t in Model.Types){<option value="@t.Key" data-sell="@organaizer.Domain.OperationTypes.Pair(t.Key).Sell" data-buy="@organaizer.Domain.OperationTypes.Pair(t.Key).Buy" data-one-sided="@organaizer.Domain.OperationTypes.IsOneSidedIncome(t.Key).ToString().ToLowerInvariant()">@(organaizer.Domain.OperationTypes.IsOneSidedIncome(t.Key)?t.Value:$"{organaizer.Domain.OperationTypes.PairLabel(t.Key)} · {t.Value}")</option>}</select></div>
    <div class="col-md-3"><label class="form-label">Дата</label><input asp-for="Input.OccurredAt" type="date" class="form-control"/></div>
    <div class="col-md-3"><label class="form-label">Срок расчёта</label><input asp-for="Input.DueAt" type="date" class="form-control"/></div>
  </div>
  <div class="row g-4">
    <div class="col-lg-6" id="sell-panel-column"><section class="operation-panel send"><h3><span class="direction">↑</span> Отдаём</h3><div class="row g-3">
      <div class="col-md-7"><label class="form-label">Сумма</label><input asp-for="Input.SellAmount" id="sell-amount-view" type="number" step="any" inputmode="decimal" class="form-control"/></div>
      <div class="col-md-5"><label class="form-label">Валюта</label><input id="sell-currency-view" class="form-control" readonly/></div>
      <div class="col-12"><label class="form-label">Откуда отправляем <span id="sell-account-currency"></span></label><select asp-for="Input.SellAccountId" class="form-select"><option value="">Не выбран</option>@foreach(var a in Model.AccountItems){<option value="@a.Id" data-currency="@a.Currency">@(a.FinancialInstitution?.Name??"Без учреждения") · @a.Name · @a.Currency</option>}</select><span asp-validation-for="Input.SellAccountId" class="text-danger"></span></div>
    </div></section></div>
    <div class="col-lg-6" id="buy-panel-column"><section class="operation-panel receive"><h3><span class="direction">↓</span> Получаем</h3><div class="row g-3">
      <div class="col-md-7"><label class="form-label">Сумма</label><input asp-for="Input.BuyAmount" id="buy-amount-view" type="number" step="any" inputmode="decimal" class="form-control"/></div>
      <div class="col-md-5"><label class="form-label">Валюта</label><select id="buy-currency-choice" asp-items="Model.Currencies" class="form-select" disabled></select></div>
      <div class="col-12"><label class="form-label">Куда получаем <span id="buy-account-currency"></span></label><select asp-for="Input.BuyAccountId" class="form-select"><option value="">Не выбран</option>@foreach(var a in Model.AccountItems){<option value="@a.Id" data-currency="@a.Currency">@(a.FinancialInstitution?.Name??"Без учреждения") · @a.Name · @a.Currency</option>}</select><span asp-validation-for="Input.BuyAccountId" class="text-danger"></span></div>
    </div></section></div>
  </div>
  <section class="operation-summary mt-4"><h3>Итог операции</h3><div class="row g-3">
    <div class="col-md-6 col-xl-3"><label class="form-label">Комиссия</label><input asp-for="Input.FeeAmount" type="number" step="any" inputmode="decimal" class="form-control"/></div>
    <div class="col-md-6 col-xl-3"><label class="form-label">Валюта комиссии</label><select asp-for="Input.FeeCurrency" asp-items="Model.Currencies" class="form-select"></select></div>
    <div class="col-md-6 col-xl-3"><label class="form-label">@(Model.IsLiquidityProvider?"Обменный курс":"Курс комиссии к USD")</label><input asp-for="Input.ExchangeRate" type="number" step="any" inputmode="decimal" class="form-control"/><div id="rate-hint" class="form-hint"></div></div>
    <div class="col-md-6 col-xl-3"><label class="form-label">Прибыль USD</label><input asp-for="Input.BaseCurrencyProfit" type="number" step="any" inputmode="decimal" class="form-control"/><div id="profit-hint" class="form-hint"></div><span asp-validation-for="Input.BaseCurrencyProfit" class="text-danger"></span></div>
    <div class="col-12"><label class="form-label">Комментарий</label><textarea asp-for="Input.Note" class="form-control" rows="2"></textarea></div>
  </div></section>
  <div class="mt-4"><button class="btn btn-primary">Сохранить изменения</button></div>
</form>

<script>document.addEventListener('DOMContentLoaded',()=>{const form=document.getElementById('operation-form'),type=document.getElementById('Input_TypeCode'),sell=document.getElementById('Input_SellCurrency'),buy=document.getElementById('Input_BuyCurrency'),sellView=document.getElementById('sell-currency-view'),buyChoice=document.getElementById('buy-currency-choice'),sellAmount=document.getElementById('sell-amount-view'),buyAmount=document.getElementById('buy-amount-view'),sellAccount=document.getElementById('Input_SellAccountId'),buyAccount=document.getElementById('Input_BuyAccountId'),sellPanel=document.getElementById('sell-panel-column'),buyPanel=document.getElementById('buy-panel-column'),rate=document.getElementById('Input_ExchangeRate'),date=document.getElementById('Input_OccurredAt'),rateHint=document.getElementById('rate-hint'),isAa=form.dataset.aa==='true',initial=true,number=v=>Number(String(v).replace(/[\s ]/g,'').replace(',','.'))||0;function filter(select,currency){[...select.options].forEach((o,i)=>{if(!i)return;const unavailable=o.dataset.currency!==currency;o.hidden=unavailable;o.disabled=unavailable;});if(select.selectedOptions[0]?.disabled)select.value='';}function refresh(){document.getElementById('sell-account-currency').textContent='· '+sell.value;document.getElementById('buy-account-currency').textContent='· '+buy.value;filter(sellAccount,sell.value);filter(buyAccount,buy.value);}async function loadRate(recalculate=true){if(!isAa||type.selectedOptions[0].dataset.oneSided==='true'){if(type.selectedOptions[0].dataset.oneSided==='true')rate.value='1';return;}const q=new URLSearchParams({handler:'Rate',sellCurrency:sell.value,buyCurrency:buy.value,date:date.value}),d=await(await fetch('?'+q)).json();rate.value=d.found?Number(d.rate).toFixed(8):'0';rateHint.textContent=d.found?'Курс '+d.source+' на дату операции':'Курс не найден — укажите вручную';if(recalculate)calculateBuy();}function calculateBuy(){if(isAa&&type.selectedOptions[0].dataset.oneSided!=='true')buyAmount.value=(number(sellAmount.value)*number(rate.value)).toFixed(2);}function pair(){const o=type.selectedOptions[0],one=o.dataset.oneSided==='true';sellPanel.classList.toggle('d-none',one);buyPanel.classList.toggle('col-lg-6',!one);buyPanel.classList.toggle('col-12',one);if(one){sell.value=buyChoice.value||buy.value||o.dataset.buy;sellAmount.value='0';sellAccount.value='';buyChoice.disabled=false;buy.value=buyChoice.value||buy.value;rateHint.textContent='Одностороннее поступление';}else{sell.value=o.dataset.sell;buy.value=o.dataset.buy;sellView.value=sell.value;buyChoice.value=buy.value;buyChoice.disabled=true;}refresh();if(!initial)loadRate(true);initial=false;}buyChoice.value=buy.value;buyChoice.addEventListener('change',()=>{buy.value=buyChoice.value;if(type.selectedOptions[0].dataset.oneSided==='true')sell.value=buy.value;refresh();});type.addEventListener('change',pair);date.addEventListener('change',()=>loadRate(true));sellAmount.addEventListener('input',calculateBuy);rate.addEventListener('input',calculateBuy);form.addEventListener('submit',()=>{buy.value=buyChoice.value||buy.value;});pair();});</script>
@if(!Model.IsLiquidityProvider){<script>document.addEventListener('DOMContentLoaded',()=>{const fee=document.getElementById('Input_FeeAmount'),currency=document.getElementById('Input_FeeCurrency'),date=document.getElementById('Input_OccurredAt'),rate=document.getElementById('Input_ExchangeRate'),profit=document.getElementById('Input_BaseCurrencyProfit'),sell=document.getElementById('Input_SellAmount'),buy=document.getElementById('Input_BuyAmount'),rateHint=document.getElementById('rate-hint'),profitHint=document.getElementById('profit-hint');const number=v=>Number(String(v).replace(/[\s ]/g,'').replace(',','.'))||0,normalize=x=>x.value=number(x.value).toString();function calculate(){if(date.value<'2026-09-01'){profitHint.textContent='Для операций до 01.09.2026 действует исторический расчёт';return;}profit.value=(number(fee.value)*number(rate.value)).toFixed(2);profitHint.textContent='Комиссия × курс к USD; прибыль можно изменить';}async function load(){const q=new URLSearchParams({handler:'ProfitRate',currency:currency.value,date:date.value}),d=await(await fetch('?'+q)).json();rate.value=d.found?Number(d.rate).toFixed(8):'0';rateHint.textContent=d.found?'Курс '+d.source+' через KGS на дату операции':'Курс не найден — укажите вручную';calculate();}[currency,date].forEach(x=>x.addEventListener('change',load));[fee,rate].forEach(x=>x.addEventListener('input',calculate));rate.form.addEventListener('submit',()=>[sell,buy,fee,rate,profit].forEach(normalize));});</script>}
