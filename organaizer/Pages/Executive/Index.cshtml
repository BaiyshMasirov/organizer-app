@page
@model organaizer.Pages.Executive.IndexModel
@{ViewData["Title"]="Дашборд руководителя";}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="mb-1">Дашборд руководителя</h1><div class="text-secondary">Ключевые показатели по двум компаниям</div></div><span class="badge bg-indigo-lt fs-5">@Model.From.ToString("dd.MM.yyyy") — @Model.To.ToString("dd.MM.yyyy")</span></div>
<form method="get" class="card card-body mb-4"><div class="row g-3"><div class="col-md-4"><label class="form-label">Дата от</label><input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control"></div><div class="col-md-4"><label class="form-label">Дата до</label><input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control"></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100">Показать</button></div></div></form>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric"><span>Прибыль</span><strong>@Model.TotalProfit.ToString("N2") USD</strong></div></div><div class="col-md-4"><div class="metric"><span>Расходы</span><strong class="text-danger">@Model.TotalExpenses.ToString("N2") USD</strong></div></div><div class="col-md-4"><div class="metric accent"><span>Финансовый результат</span><strong class="@(Model.TotalNet<0?"text-danger":"text-success")">@Model.TotalNet.ToString("N2") USD</strong></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-6"><div class="card h-100"><div class="card-header">Финансовый результат по компаниям</div><div class="card-body chart-wrap"><canvas id="company-chart"></canvas></div></div></div><div class="col-lg-6"><div class="card h-100"><div class="card-header">Покупка и продажа USDT · Orient Capital</div><div class="card-body chart-wrap"><canvas id="orient-chart"></canvas></div></div></div></div>
<div class="card mb-4"><div class="card-header">Финансовый результат</div><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Компания</th><th class="text-end">Прибыль</th><th class="text-end">Расходы</th><th class="text-end">Результат</th></tr></thead><tbody>@foreach(var x in Model.CompanyResults){<tr><td><strong>@x.Company</strong></td><td class="text-end">@x.Profit.ToString("N2") USD</td><td class="text-end text-danger">@x.Expenses.ToString("N2") USD</td><td class="text-end fw-bold @(x.Net<0?"text-danger":"text-success")">@x.Net.ToString("N2") USD</td></tr>}</tbody></table></div></div>
<div class="card mb-4"><div class="card-header">Обороты по валютным парам · A&amp;A Liquidity</div><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Пара</th><th class="text-end">Операций</th><th class="text-end">Отдали</th><th class="text-end">Получили</th></tr></thead><tbody>@foreach(var x in Model.AaTurnovers){<tr><td><span class="currency-token">@x.Pair</span></td><td class="text-end">@x.Count</td><td class="text-end">@x.SellAmount.ToString("N2") @x.SellCurrency</td><td class="text-end">@x.BuyAmount.ToString("N2") @x.BuyCurrency</td></tr>}@if(Model.AaTurnovers.Count==0){<tr><td colspan="4" class="empty-state">Нет операций за период</td></tr>}</tbody></table></div></div>
<div class="card mb-4"><div class="card-header">Обороты покупки/продажи USDT · Orient Capital</div><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Направление</th><th>Пара</th><th class="text-end">Операций</th><th class="text-end">Оборот USDT</th><th class="text-end">Вторая сторона</th></tr></thead><tbody>@foreach(var x in Model.OrientTurnovers){<tr><td><strong>@x.Direction</strong></td><td>@x.Pair</td><td class="text-end">@x.Count</td><td class="text-end fw-bold">@x.UsdtAmount.ToString("N2") USDT</td><td class="text-end">@x.CounterAmount.ToString("N2") @x.CounterCurrency</td></tr>}@if(Model.OrientTurnovers.Count==0){<tr><td colspan="5" class="empty-state">Нет операций за период</td></tr>}</tbody></table></div></div>
<div class="card"><div class="card-header">Остатки по банковским счетам и кошелькам</div><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Компания</th><th>Счёт / кошелёк</th><th>Тип</th><th>Валюта</th><th class="text-end">Остаток</th></tr></thead><tbody>@foreach(var x in Model.Balances){<tr><td>@x.Company</td><td><strong>@x.Account</strong></td><td>@x.Kind</td><td><span class="currency-token">@x.Currency</span></td><td class="text-end fw-bold @(x.Balance<0?"text-danger":"")">@x.Balance.ToString("N2") @x.Currency</td></tr>}@if(Model.Balances.Count==0){<tr><td colspan="5" class="empty-state">Счета не найдены</td></tr>}</tbody></table></div></div>
@section Scripts{<script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.7/dist/chart.umd.min.js"></script><script>const companyLabels=@Html.Raw(Model.CompanyLabels),companyValues=@Html.Raw(Model.CompanyValues),orientLabels=@Html.Raw(Model.OrientLabels),orientValues=@Html.Raw(Model.OrientValues);new Chart(document.getElementById('company-chart'),{type:'bar',data:{labels:companyLabels,datasets:[{label:'Результат, USD',data:companyValues,backgroundColor:companyValues.map(x=>x<0?'#ef4444':'#4f46e5'),borderRadius:7}]},options:{responsive:true,maintainAspectRatio:false}});new Chart(document.getElementById('orient-chart'),{type:'bar',data:{labels:orientLabels,datasets:[{label:'Оборот, USDT',data:orientValues,backgroundColor:'#10b981',borderRadius:7}]},options:{responsive:true,maintainAspectRatio:false,indexAxis:'y'}});</script>}
