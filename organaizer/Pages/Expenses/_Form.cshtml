@model organaizer.Pages.Expenses.ExpenseForm
<form method="post" class="card card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" name="Input.Id" value="@Model.Id"/><div class="row g-3"><div class="col-md-6"><label class="form-label">Компания</label><select name="Input.CompanyId" asp-items="ViewBag.Companies" class="form-select"></select></div><div class="col-md-6"><label class="form-label">Счет / банк</label><select name="Input.AccountId" asp-items="ViewBag.Accounts" class="form-select"></select></div><div class="col-md-3"><label class="form-label">Дата</label><input name="Input.OccurredAt" value="@Model.OccurredAt.ToString("yyyy-MM-dd")" type="date" class="form-control"/></div><div class="col-md-5"><label class="form-label">Категория</label><input name="Input.Category" value="@Model.Category" class="form-control"/></div><div class="col-md-2"><label class="form-label">Сумма</label><input name="Input.Amount" value="@Model.Amount" class="form-control"/></div><div class="col-md-2"><label class="form-label">Валюта</label><select name="Input.Currency" asp-items="ViewBag.Currencies" class="form-select"></select></div><div class="col-12"><label class="form-label">Комментарий</label><textarea name="Input.Note" class="form-control">@Model.Note</textarea></div><div class="col-12"><button class="btn btn-primary">Сохранить</button> <a asp-page="Index" class="btn btn-light">Отмена</a></div></div></form>
