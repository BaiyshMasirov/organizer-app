@page
@model organaizer.Pages.Expenses.IndexModel
@{ViewData["Title"]="Расходы";}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="mb-1">Расходы</h1><div class="text-secondary">Банковские комиссии, агентские выплаты и прочие затраты</div></div><a asp-page="Create" class="btn btn-primary">Добавить расход</a></div>
<form method="get" class="card card-body mb-4"><div class="row g-2"><div class="col-md-3"><label class="form-label">Компания</label><select name="companyId" class="form-select"><option value="">Все компании</option>@foreach(var x in Model.Companies){<option value="@x.Key" selected="@(Model.CompanyId==x.Key)">@x.Value</option>}</select></div><div class="col-md-2"><label class="form-label">Год</label><input name="year" value="@Model.Year" type="number" class="form-control"/></div><div class="col-md-2"><label class="form-label">Месяц</label><select name="month" class="form-select"><option value="">Все</option>@for(var m=1;m<=12;m++){<option value="@m" selected="@(Model.Month==m)">@m</option>}</select></div><div class="col-md-3"><label class="form-label">Категория</label><input name="category" value="@Model.Category" class="form-control"/></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Фильтр</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Дата</th><th>Компания</th><th>Категория</th><th>Счет</th><th class="text-end">Сумма</th><th>Комментарий</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.OccurredAt.ToString("dd.MM.yyyy")</td><td>@Model.Companies.GetValueOrDefault(x.CompanyId)</td><td>@x.Category</td><td>@Model.Accounts.GetValueOrDefault(x.AccountId)</td><td class="text-end fw-bold">@x.Amount.ToString("N2") @x.Currency</td><td>@(x.Note??"—")</td><td class="text-end text-nowrap"><a asp-page="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">Изменить</a></td></tr>}@if(Model.Items.Count==0){<tr><td colspan="7" class="empty-state">Расходы не найдены</td></tr>}</tbody></table></div></div>
