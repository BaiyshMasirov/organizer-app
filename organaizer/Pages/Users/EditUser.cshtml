@page
@model organaizer.Pages.Users.EditUserModel
@{ViewData["Title"]="Редактирование пользователя";}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="mb-1">Редактирование пользователя</h1><div class="text-secondary">Логин, пароль, статус и назначенные роли</div></div><a asp-page="/Users/Index" asp-route-tab="users" class="btn btn-outline-secondary">← К пользователям</a></div>
@if(ViewData.ModelState.ErrorCount>0){<div asp-validation-summary="All" class="alert alert-danger"></div>}
<form method="post" class="card card-body"><input asp-for="Id" type="hidden"><div class="row g-4"><div class="col-lg-6"><div class="mb-3"><label asp-for="UserName" class="form-label">Логин</label><input asp-for="UserName" class="form-control" required></div><div class="mb-3"><label asp-for="NewPassword" class="form-label">Новый пароль</label><input asp-for="NewPassword" type="password" minlength="8" class="form-control"><div class="form-hint">Оставьте пустым, чтобы не менять пароль.</div></div><label class="form-check form-switch"><input asp-for="IsActive" class="form-check-input"><span class="form-check-label">Пользователь активен</span></label></div><div class="col-lg-6"><div class="form-label">Роли пользователя</div>@foreach(var role in Model.AvailableRoles){<label class="form-check mb-2"><input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role.Name" checked="@Model.SelectedRoles.Contains(role.Name)"><span class="form-check-label">@role.Name</span></label>}@if(Model.AvailableRoles.Count==0){<div class="alert alert-info">Сначала создайте роль во вкладке «Роли».</div>}</div></div><div class="mt-4 text-end"><button class="btn btn-primary">Сохранить пользователя</button></div></form>
