@model organaizer.Pages.Users.PermissionGridModel
<div class="table-responsive"><table class="table table-sm table-vcenter mb-0"><thead><tr><th>Раздел</th><th class="text-center">Просмотр</th><th class="text-center">Создание</th><th class="text-center">Редактирование</th></tr></thead><tbody>@foreach(var section in Model.Sections){<tr><td><strong>@(section.Name)</strong></td><td class="text-center"><input class="form-check-input" type="checkbox" name="@Model.FieldName" value="@(section.View)" checked="@Model.Selected.Contains(section.View)"></td><td class="text-center">@if(section.CanCreate){<input class="form-check-input" type="checkbox" name="@Model.FieldName" value="@(section.Create)" checked="@Model.Selected.Contains(section.Create)">}else{<span class="text-secondary">—</span>}</td><td class="text-center">@if(section.CanEdit){<input class="form-check-input" type="checkbox" name="@Model.FieldName" value="@(section.Edit)" checked="@Model.Selected.Contains(section.Edit)">}else{<span class="text-secondary">—</span>}</td></tr>}</tbody></table></div>
