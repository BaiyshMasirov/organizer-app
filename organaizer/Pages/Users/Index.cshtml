@page
@model organaizer.Pages.Users.IndexModel
@{ViewData["Title"]="Пользователи и роли"; var rolesTab=Model.Tab=="roles";}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="mb-1">Пользователи и роли</h1><div class="text-secondary">Учетные записи и ролевые права доступа</div></div><span class="badge bg-purple-lt fs-5">Super Admin</span></div>
@if(Model.Message is not null){<div class="alert alert-success">@Model.Message</div>} @if(ViewData.ModelState.ErrorCount>0){<div asp-validation-summary="All" class="alert alert-danger"></div>}
<ul class="nav nav-tabs mb-4"><li class="nav-item"><a class="nav-link @(!rolesTab?"active":"")" asp-page="/Users/Index" asp-route-tab="users">Пользователи</a></li><li class="nav-item"><a class="nav-link @(rolesTab?"active":"")" asp-page="/Users/Index" asp-route-tab="roles">Роли</a></li></ul>
@if(!rolesTab){
<div class="d-flex justify-content-end mb-4"><button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#create-user-modal">Создать пользователя</button></div>
<form method="get" class="card card-body mb-4"><input type="hidden" name="tab" value="users"><div class="row g-3 align-items-end"><div class="col-md-9"><label class="form-label">Поиск по логину</label><input name="search" value="@Model.Search" class="form-control" placeholder="Введите логин..."></div><div class="col-md-3"><div class="d-flex gap-2"><button class="btn btn-primary flex-fill">Найти</button><a asp-page="/Users/Index" asp-route-tab="users" class="btn btn-outline-secondary">Сбросить</a></div></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Логин</th><th>Статус</th><th>Роли</th><th class="text-end">Действия</th></tr></thead><tbody>@foreach(var user in Model.UserItems){<tr><td><strong>@user.UserName</strong></td><td>@if(user.IsActive){<span class="badge bg-green-lt">Активен</span>}else{<span class="badge bg-red-lt">Отключён</span>}</td><td>@if(user.Roles.Count==0){<span class="text-secondary">Роли не назначены</span>}else{@foreach(var role in user.Roles){<span class="badge bg-purple-lt me-1">@role</span>}}</td><td class="text-end">@if(user.IsSuperAdmin){<span class="text-secondary">Системный пользователь</span>}else{<a asp-page="/Users/EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Редактировать</a>}</td></tr>}@if(Model.UserItems.Count==0){<tr><td colspan="4" class="empty-state">Пользователи не найдены</td></tr>}</tbody></table></div></div>
}else{
<div class="d-flex justify-content-end mb-4"><button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#create-role-modal">Создать роль</button></div>
<form method="get" class="card card-body mb-4"><input type="hidden" name="tab" value="roles"><div class="row g-3 align-items-end"><div class="col-md-9"><label class="form-label">Поиск по наименованию</label><input name="search" value="@Model.Search" class="form-control" placeholder="Введите наименование роли..."></div><div class="col-md-3"><div class="d-flex gap-2"><button class="btn btn-primary flex-fill">Найти</button><a asp-page="/Users/Index" asp-route-tab="roles" class="btn btn-outline-secondary">Сбросить</a></div></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Роль</th><th class="text-end">Пользователей</th><th class="text-end">Разрешений</th><th class="text-end">Действия</th></tr></thead><tbody>@foreach(var role in Model.RoleItems){<tr><td><strong>@role.Name</strong>@if(role.IsSystem){<span class="badge bg-purple-lt ms-2">Системная</span>}</td><td class="text-end">@role.UserCount</td><td class="text-end">@(role.IsSystem?"Все":role.PermissionCount)</td><td class="text-end">@if(role.IsSystem){<span class="text-secondary">Не редактируется</span>}else{<a asp-page="/Users/EditRole" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary">Права роли</a>}</td></tr>}@if(Model.RoleItems.Count==0){<tr><td colspan="4" class="empty-state">Роли не найдены</td></tr>}</tbody></table></div></div>
}

<div class="modal" id="create-user-modal" tabindex="-1"><div class="modal-dialog"><form method="post" asp-page-handler="CreateUser" class="modal-content"><input type="hidden" name="Tab" value="users"><div class="modal-header"><h3 class="modal-title">Создать пользователя</h3><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Логин</label><input name="username" class="form-control" required autofocus></div><div class="mb-3"><label class="form-label">Пароль</label><input name="password" type="password" minlength="8" class="form-control" required><div class="form-hint">Минимум 8 символов.</div></div><div class="mb-3"><label class="form-label">Роли</label><select name="selectedRoles" class="form-select" multiple size="4">@foreach(var role in Model.AssignableRoles){<option value="@role.Name">@role.Name</option>}</select><div class="form-hint">Можно выбрать несколько ролей.</div></div><label class="form-check form-switch"><input name="isActive" value="true" checked class="form-check-input"><span class="form-check-label">Пользователь активен</span></label></div><div class="modal-footer"><button type="button" class="btn btn-link" data-bs-dismiss="modal">Отмена</button><button class="btn btn-primary">Создать</button></div></form></div></div>
<div class="modal" id="create-role-modal" tabindex="-1"><div class="modal-dialog"><form method="post" asp-page-handler="CreateRole" class="modal-content"><input type="hidden" name="Tab" value="roles"><div class="modal-header"><h3 class="modal-title">Создать роль</h3><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Наименование роли</label><input name="roleName" class="form-control" placeholder="Например: Оператор" required autofocus><div class="form-hint">После создания откроется страница назначения разрешений.</div></div><div class="modal-footer"><button type="button" class="btn btn-link" data-bs-dismiss="modal">Отмена</button><button class="btn btn-primary">Создать роль</button></div></form></div></div>
