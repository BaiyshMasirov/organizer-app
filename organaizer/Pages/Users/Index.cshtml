@page
@model organaizer.Pages.Users.IndexModel
@{ViewData["Title"]="Пользователи и права";}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="mb-1">Пользователи и права</h1><div class="text-secondary">Доступ к разделам и отдельным действиям</div></div><span class="badge bg-purple-lt fs-5">Super Admin</span></div>
@if(Model.Message is not null){<div class="alert alert-success">@Model.Message</div>}
@if(ViewData.ModelState.ErrorCount>0){<div asp-validation-summary="All" class="alert alert-danger"></div>}

<div class="card card-body mb-4"><h3 class="card-title">Создать пользователя</h3><form method="post" asp-page-handler="Create"><div class="row g-3"><div class="col-md-4"><label class="form-label">Логин</label><input name="username" class="form-control" required></div><div class="col-md-4"><label class="form-label">Пароль</label><input name="password" type="password" minlength="8" class="form-control" required></div><div class="col-md-2 d-flex align-items-end"><label class="form-check form-switch mb-2"><input name="isActive" value="true" checked class="form-check-input"><span class="form-check-label">Активен</span></label></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Создать</button></div></div><div class="mt-3"><div class="form-label">Начальные права</div><partial name="_PermissionGrid" model="@(new organaizer.Pages.Users.PermissionGridModel(Model.Sections,new HashSet<string>(),"permissions"))"/></div></form></div>

@foreach(var user in Model.Items){<div class="card mb-4"><div class="card-header"><div><strong>@user.UserName</strong><div class="small text-secondary">@(user.IsSuperAdmin?"Полный неограниченный доступ":user.IsActive?"Активен":"Отключён")</div></div>@if(user.IsSuperAdmin){<span class="badge bg-purple-lt ms-auto">Super Admin</span>}</div><div class="card-body">@if(user.IsSuperAdmin){<div class="alert alert-info mb-0">Супер-администратор имеет все права и управляет пользователями.</div>}else{<form method="post" asp-page-handler="Save"><input type="hidden" name="userId" value="@user.Id"><div class="row g-3 mb-3"><div class="col-md-4"><label class="form-check form-switch mt-3"><input name="isActive" value="true" checked="@user.IsActive" class="form-check-input"><span class="form-check-label">Пользователь активен</span></label></div><div class="col-md-5"><label class="form-label">Новый пароль (необязательно)</label><input name="newPassword" type="password" minlength="8" class="form-control"></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100">Сохранить права</button></div></div><partial name="_PermissionGrid" model="@(new organaizer.Pages.Users.PermissionGridModel(Model.Sections,user.Permissions,"permissions"))"/></form>}</div></div>}
