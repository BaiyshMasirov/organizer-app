@page
@model organaizer.Pages.Users.EditRoleModel
@{ViewData["Title"]="Права роли";}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="mb-1">Права роли</h1><div class="text-secondary">Каждое действие назначается отдельным разрешением</div></div><a asp-page="/Users/Index" asp-route-tab="roles" class="btn btn-outline-secondary">← К ролям</a></div>
@if(ViewData.ModelState.ErrorCount>0){<div asp-validation-summary="All" class="alert alert-danger"></div>}
<form method="post"><input asp-for="Id" type="hidden"><div class="card card-body mb-4"><label asp-for="RoleName" class="form-label">Наименование роли</label><input asp-for="RoleName" class="form-control" required></div><div class="card mb-4"><div class="card-header"><div><div class="card-title">Разрешения</div><div class="text-secondary small">Создание и редактирование автоматически включают просмотр раздела.</div></div></div><partial name="_PermissionGrid" model="@(new organaizer.Pages.Users.PermissionGridModel(Model.Sections,Model.Selected,"Permissions"))"/></div><div class="d-flex justify-content-between"><button type="submit" asp-page-handler="Delete" class="btn btn-outline-danger" onclick="return confirm('Удалить эту роль?')">Удалить роль</button><button class="btn btn-primary">Сохранить роль и права</button></div></form>
