@page
@model organaizer.Pages.ExchangeRates.IndexModel
@{ViewData["Title"]="Курсы валют";}
<div class="mb-4"><h1 class="mb-1">Справочник курсов валют</h1><div class="text-secondary">Стоимость одной единицы валюты в USDT; отчет использует последнюю запись на конец периода</div></div>
<form method="get" class="card card-body mb-4"><div class="row g-2"><div class="col-md-3"><label class="form-label">Валюта</label><select name="currency" asp-items="Model.Currencies" class="form-select"><option value="">Все валюты</option></select></div><div class="col-md-3"><label class="form-label">Год</label><input name="year" value="@Model.Year" type="number" class="form-control"/></div><div class="col-md-3"><label class="form-label">Месяц</label><select name="month" class="form-select"><option value="">Все</option>@for(var m=1;m<=12;m++){<option value="@m" selected="@(Model.Month==m)">@m</option>}</select></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100">Фильтр</button></div></div></form>
<div class="row g-4"><div class="col-xl-8"><div class="card"><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Дата</th><th>Валюта</th><th class="text-end">Курс к USDT</th><th>Источник</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.EffectiveAt.ToString("dd.MM.yyyy")</td><td><span class="currency-token">@x.Currency</span></td><td class="text-end fw-bold">@x.RateToUsd.ToString("N8")</td><td>@(x.Note??"—")</td><td class="text-end"><a asp-route-edit="@x.Id" class="btn btn-sm btn-outline-primary">Изменить</a></td></tr>}@if(Model.Items.Count==0){<tr><td colspan="5" class="empty-state">Курсы не найдены</td></tr>}</tbody></table></div></div></div><div class="col-xl-4"><form method="post" class="card card-body"><h3 class="card-title">@(Model.Input.Id==Guid.Empty?"Добавить курс":"Изменить курс")</h3><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="Input.Id"/><div class="mb-3"><label class="form-label">Валюта</label><select asp-for="Input.Currency" asp-items="Model.Currencies" class="form-select"></select></div><div class="mb-3"><label class="form-label">Дата курса</label><input asp-for="Input.EffectiveAt" type="date" class="form-control"/></div><div class="mb-3"><label class="form-label">Стоимость 1 единицы в USDT</label><input asp-for="Input.RateToUsd" class="form-control" placeholder="0,01200000"/></div><div class="mb-3"><label class="form-label">Комментарий</label><textarea asp-for="Input.Note" class="form-control"></textarea></div><button class="btn btn-primary">Сохранить</button></form>@if(Model.Input.Id!=Guid.Empty){<form method="post" asp-page-handler="Delete" class="mt-3" onsubmit="return confirm('Удалить курс?')"><input type="hidden" name="id" value="@Model.Input.Id"/><button class="btn btn-danger w-100">Удалить курс</button></form>}</div></div>
