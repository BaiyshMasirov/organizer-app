@page
@model organaizer.Pages.OrientExchangeRates.IndexModel
@{ViewData["Title"]="Курсы НБКР для Ориента";}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="mb-1">Курсы НБКР для Ориента</h1><div class="text-secondary">Официальные курсы к кыргызскому сому; прибыль рассчитывается через KGS в USD</div></div><form method="post" asp-page-handler="Sync"><button class="btn btn-primary">Обновить сейчас</button></form></div>
@if(Model.Message is not null){<div class="alert alert-success">@Model.Message</div>}
<div class="alert alert-info">Автообновление выполняется раз в сутки из daily.xml и weekly.xml НБКР. Используются USD, EUR, CNY, AED и RUB; для KGS курс всегда равен 1.</div>
<div class="card"><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Дата</th><th>Валюта</th><th class="text-end">Номинал</th><th class="text-end">Сомов</th><th class="text-end">Курс к USD</th><th>Источник</th><th>Синхронизация</th></tr></thead><tbody>
@foreach(var x in Model.Items){var usd=Model.Items.Where(r=>r.Currency=="USD"&&r.EffectiveAt<=x.EffectiveAt).OrderByDescending(r=>r.EffectiveAt).FirstOrDefault();var rate=usd is null?null:(decimal?)((x.ValueInKgs/x.Nominal)/(usd.ValueInKgs/usd.Nominal));<tr><td>@x.EffectiveAt.ToString("dd.MM.yyyy")</td><td><span class="currency-token">@x.Currency</span></td><td class="text-end">@x.Nominal.ToString("N0")</td><td class="text-end fw-bold">@x.ValueInKgs.ToString("N4")</td><td class="text-end">@(rate?.ToString("N8")??"—")</td><td>@(x.Feed+".xml")</td><td>@x.SyncedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td></tr>}
@if(Model.Items.Count==0){<tr><td colspan="7" class="empty-state">Курсы ещё не загружены. Нажмите «Обновить сейчас».</td></tr>}
</tbody></table></div></div>
