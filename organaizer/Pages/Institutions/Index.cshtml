@page
@model organaizer.Pages.Institutions.IndexModel
@{ViewData["Title"]="Банки и каналы";}
<div class="mb-4"><h1 class="mb-1">Банки и платежные каналы</h1><div class="text-secondary">Справочник для операций получения и отправки</div></div><div class="row g-4"><div class="col-lg-7"><div class="card"><table class="table table-vcenter mb-0"><thead><tr><th>Название</th><th>Тип</th><th>Комментарий</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><strong>@x.Name</strong></td><td><span class="badge bg-azure-lt">@x.Kind</span></td><td class="text-secondary">@(x.Note??"—")</td></tr>}</tbody></table></div></div><div class="col-lg-5"><form method="post" class="card card-body"><h3 class="card-title">Добавить банк или канал</h3><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label class="form-label">Название</label><input asp-for="Input.Name" class="form-control"/></div><div class="mb-3"><label class="form-label">Тип</label><select asp-for="Input.Kind" asp-items="Html.GetEnumSelectList<organaizer.Domain.InstitutionKind>()" class="form-select"></select></div><div class="mb-3"><label class="form-label">Комментарий</label><input asp-for="Input.Note" class="form-control"/></div><button class="btn btn-primary">Добавить в справочник</button></form></div></div>
