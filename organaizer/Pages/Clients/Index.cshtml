@page
@model organaizer.Pages.Clients.IndexModel
@{ViewData["Title"]="Клиенты";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="mb-1">Клиенты</h1><div class="text-secondary">Справочник клиентов из Orient Capital и A&amp;A</div></div><a class="btn btn-primary" asp-page="Create">+ Добавить клиента</a></div>
<form method="get" class="card card-body mb-4"><div class="row g-2"><div class="col-md-5"><select name="companyId" class="form-select"><option value="">Все компании</option>@foreach(var c in Model.Companies){<option value="@c.Id" selected="@(Model.CompanyId==c.Id)">@c.Name</option>}</select></div><div class="col-md-5"><input name="search" value="@Model.Search" class="form-control" placeholder="Поиск по названию..."/></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Найти</button></div></div></form>
<div class="card"><div class="card-header"><span>Всего клиентов</span><span class="badge bg-blue-lt ms-2">@Model.Clients.Count</span></div><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Клиент</th><th>Компания</th><th>Код</th><th>Статус</th><th></th></tr></thead><tbody>@foreach(var x in Model.Clients){var company=Model.Companies.First(c=>c.Id==x.CompanyId);<tr><td><strong>@x.Name</strong>@if(!string.IsNullOrWhiteSpace(x.Note)){<div class="small text-secondary">@x.Note</div>}</td><td>@company.Name</td><td>@(x.Code??"—")</td><td><span class="badge @(x.IsActive?"bg-green-lt":"bg-secondary-lt")">@(x.IsActive?"Активен":"Отключен")</span></td><td class="text-end"><a asp-page="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-ghost-primary">Изменить</a></td></tr>}</tbody></table></div></div>
