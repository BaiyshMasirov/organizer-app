@page
@model organaizer.Pages.Clients.CreateModel
@{ViewData["Title"]="Новый клиент";}
<div class="page-header mb-4"><h1>Новый клиент</h1><div class="text-secondary">Добавление в справочник контрагентов</div></div><form method="post" class="card card-body"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Компания</label><select asp-for="Input.CompanyId" asp-items="Model.Companies" class="form-select"></select></div><div class="col-md-6"><label class="form-label">Название клиента</label><input asp-for="Input.Name" class="form-control"/><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="col-md-4"><label class="form-label">Внутренний код</label><input asp-for="Input.Code" class="form-control"/></div><div class="col-md-8"><label class="form-label">Комментарий</label><input asp-for="Input.Note" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">Сохранить</button> <a asp-page="Index" class="btn btn-ghost-secondary">Отмена</a></div></div></form>
