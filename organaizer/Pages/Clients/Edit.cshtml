@page "{id:guid}"
@model organaizer.Pages.Clients.EditModel
@{ViewData["Title"]="Редактирование клиента";}
<h1 class="mb-4">Редактирование клиента</h1><form method="post" class="card card-body"><input asp-for="Input.Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-8"><label class="form-label">Название</label><input asp-for="Input.Name" class="form-control"/></div><div class="col-md-4"><label class="form-label">Код</label><input asp-for="Input.Code" class="form-control"/></div><div class="col-12"><label class="form-label">Комментарий</label><textarea asp-for="Input.Note" class="form-control"></textarea></div><div class="col-12"><label class="form-check form-switch"><input asp-for="Input.IsActive" class="form-check-input"/><span class="form-check-label">Клиент активен</span></label></div><div class="col-12"><button class="btn btn-primary">Сохранить</button> <a asp-page="Index" class="btn btn-ghost-secondary">Отмена</a></div></div></form>
